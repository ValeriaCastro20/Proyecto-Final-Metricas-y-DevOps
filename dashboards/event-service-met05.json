  "panels": [
    {
      "id": 1,
      "title": "Recepción por resultado",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "event-service-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "description": "Series reales; ausencia de datos no se sustituye por cero. Ventana de tasas: 5 minutos.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(esc3_events_received_total{job=\"event-service\"}[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
